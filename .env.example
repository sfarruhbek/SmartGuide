# ==============================================================================
# SmartGuide — Ichan-Qala (Khiva) AI Tour Guide Infrastructure
# Copy to .env. Server credentials may also live in the ignored root .env.ai.local.
# ==============================================================================

# --- Groq: trip planning, grounded guide text and photo classification ---
# Comma-separated server-only keys. Keys in one organization SHARE rate limits.
GROQ_API_KEYS=your_groq_api_key_here
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- Gemini: speech generation only ---
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Models must be enabled for your project; availability and quotas can change.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_FALLBACK_MODELS=gemini-3.8-flash-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Sulafat
AI_REQUEST_TIMEOUT_MS=25000
AI_MAX_CONCURRENT=4
AI_REQUESTS_PER_MINUTE=20

# --- PostgreSQL (Local or AWS Ubuntu native service) ---
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/smartguide

# --- API Server (apps/api) ---
API_PORT=4000
LANDMARK_STORE=postgres
# For a live-AI demo before DB setup: LANDMARK_STORE=json and AUTO_SEED=false.
AUTO_SEED=false
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# --- Business Model Parameters (B2B2C Revenue Share) ---
TICKET_PRICE_USD=4
MUSEUM_REVENUE_SHARE_PERCENT=30
ESTIMATED_API_COST_PER_TOURIST_USD=0.15

# --- Tourist PWA (apps/tourist — Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side target for Next's same-origin /api proxy (HTTPS/LAN previews).
SMARTGUIDE_API_ORIGIN=http://127.0.0.1:4000

# --- B2B Museum Dashboard (apps/dashboard — React + Vite) ---
VITE_API_URL=http://localhost:4000
# Base URL encoded into printed QR codes (replace with your AWS domain/IP in production)
VITE_TOURIST_APP_URL=http://localhost:3000
