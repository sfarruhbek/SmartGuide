{
  "name": "@smartguide/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "ai:check": "tsx scripts/check-ai.ts",
    "ai:smoke": "tsx scripts/smoke-ai.ts",
    "catalog:sync": "tsx scripts/sync-planner-catalog.ts",
    "explore:seed": "tsx scripts/seed-explore.ts",
    "explore:cache-check": "tsx scripts/check-explore-cache.ts",
    "voice:probe": "tsx scripts/probe-live.ts",
    "voice:check": "tsx scripts/check-live-assistant.ts",
    "db:push": "drizzle-kit push --force",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@smartguide/shared": "*",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "ws": "^8.23.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.14",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.4",
    "typescript": "^5.8.2"
  }
}
